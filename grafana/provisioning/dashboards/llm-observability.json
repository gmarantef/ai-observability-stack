          "rawSql": "SELECT avg(toUInt64OrZero(SpanAttributes['gen_ai.usage.input_tokens'])) AS value\nFROM otel.otel_traces\nWHERE $__timeFilter(Timestamp)\n  AND SpanAttributes['gen_ai.request.model'] != ''\n  AND $__conditionalAll(SpanAttributes['gen_ai.request.model'] IN (${model:singlequote}), $model)",
