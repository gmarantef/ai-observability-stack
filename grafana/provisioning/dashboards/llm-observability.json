        "textMode": "auto"
      },
      "title": "Avg Output Tokens / Request",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "rawSql": "SELECT avg(toUInt64OrZero(SpanAttributes['gen_ai.usage.output_tokens'])) AS value\nFROM otel.otel_traces\nWHERE $__timeFilter(Timestamp)\n  AND SpanAttributes['gen_ai.request.model'] != ''\n  AND $__conditionalAll(SpanAttributes['gen_ai.request.model'] IN (${model:singlequote}), $model)",
          "refId": "A",
